# ─── Supabase / App secrets ───────────────────────────────────────────────────
# Public Supabase URL (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable anon key (safe in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — SERVER ONLY. NEVER expose to browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Token encryption ─────────────────────────────────────────────────────────
# AES-256-GCM key — SERVER ONLY. Generate with: npm run generate-key
# Must be exactly 64 hex characters (32 bytes).
TOKEN_ENCRYPTION_KEY=

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
